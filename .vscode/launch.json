{
  "version": "2.0.0",
  "configurations": [
    {
      "name": "run",
      "type": "node-terminal",
      "request": "launch",
      "command": "cargo run"
    },
    {
      "name": "run-proxy",
      "type": "node-terminal",
      "request": "launch",
      "command": "cargo run -- -a"
    },
    {
      "name": "run-debug",
      "type": "node-terminal",
      "request": "launch",
      "command": "cargo run",
      "env": {
        "RUST_LOG": "debug"
      }
    }
  ]
}
